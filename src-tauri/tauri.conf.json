{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spacetime-studio",
  "version": "0.6.0",
  "identifier": "com.spacetime-studio",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spacetime Studio",
        "width": 1280,
        "height": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMkFDQkRBQTI2NDQ0QzkKUldUSlJHU2kyc3NxMmw3cnR0bEphWThkbDcvblVFTkE1ZDdrQ3pKT3hST21pOHp4YzI4Q3poT08K",
      "endpoints": [
        "https://github.com/ElegonCode/spacetime-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
